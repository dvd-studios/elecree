[node name="NPC" type="Area2D" parent="."]
script = ExtResource( 7 )
npc_name = "pete_on_call"
texts = [ "Ring... Ring...", "Pete: So, you made it to the first gate!", "Pete: Here's what I have to tell you about this one:", "Pete: Since this is your first gate, I'd like to introduce you to Gate Mechanics.", "Pete: To sum it up, a Gate Mechanic is a condition that applies to all battles in a Gate.", "Pete: This Gate's mechanic is called the Alternator: Here's how it works.", "Pete: The Alternator determines the target of all Thunder-element attacks.", "Pete: It flips 30 times a second, so learn how creatures' speeds interact with it.", "Pete: However, the good news:", "Pete: You don't need to use Thunder-element attacks at all!", "Pete: So, the Alternator affects Voma's Elecree more than it affects yours!", "Pete: Just remember, Thunder is weak to Earth and Fire.", "Pete: Anyways, I believe in you, go get that first Medallion!", "Click..." ]

